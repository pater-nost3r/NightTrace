# NightTrace needs no secrets. Both data sources are public:
#   IRSA SIA v2 (https://irsa.ipac.caltech.edu/SIA) and the IRSA AWS Open Data copy
#   (https://nasa-irsa-spherex.s3.us-east-1.amazonaws.com). No API key is used.
#
# Optional, local development only (Vercel ignores them):
HOST=127.0.0.1
PORT=8000
